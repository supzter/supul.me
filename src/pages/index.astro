---
import HomeLayout from '../layouts/HomeLayout.astro';
import ProjectSummary from '../components/ProjectSummary.astro';
import ContactCTA from '../components/ContactCTA.astro';

import character from '../../public/character.png';
import character2 from '../../public/character-2.png';
import hatsCollection from '../../public/hats-collection.png';
import moreHats from '../../public/more-hats.png';
import evenMoreHats from '../../public/even-more-hats.png';
import mobileApp from '../../public/mobile-app.png';
import dashboard from '../../public/dashboard.png';
import enterprise from '../../public/enterprise.png';
import resume from '../../public/Supul-amarakoon-resume-2026.pdf';
---

<HomeLayout title="Supul Amarakoon - Product Designer & Developer">
  <!-- Hero Section -->
  <section class="min-h-[85vh] flex items-center main-hero">
    <div class="max-w-6xl mx-auto px-6 py-20 w-full">
      <div class="grid md:grid-cols-2 gap-16 items-center text-center md:text-left">
        <div class="avatar-image-mobile flex justify-center md:hidden mb-10">
          <img src={character.src} alt="Supul's character illustration" class="w-full max-w-lg" />
        </div>
        <div class="flex flex-col items-center md:items-start">
          <h1 class="text-5xl md:text-7xl font-bold mb-8 text-gray-900 leading-tight">
            Hi, I'm Supul.
          </h1>
          <p class="text-xl text-gray-700 mb-6 leading-relaxed">
            Hired as a Product Designer, learned to be a Product Manager, working as a Product Delivery Manager!
          </p>
          <p class="text-xl text-gray-700 mb-6 leading-relaxed">
            Master of Digital Product Management '25 Queens University
          </p>
          <p class="text-xl text-gray-700 mb-10 leading-relaxed">
            Professional Webtoon Artist in my free time.
          </p>
          <div class="flex gap-4 flex-wrap justify-center md:justify-start">
          <a href="mailto:supul.amarakoon@gmail.com" class="connectbtn px-6 py-3 bg-[#50A684] text-white rounded-full hover:bg-[#3D8268] transition-colors font-medium" target="parent">
            Let's connect
          </a>
            <a href={resume} class="px-6 py-3 border-2 border-gray-300 text-gray-700 rounded-full hover:border-gray-400 transition-colors font-medium resumebtn" target="parent">
              Download my Resume
            </a>
          </div>
        </div>
        <div class="avatar-image hidden md:flex justify-center">
          <img src={character.src} alt="Supul's character illustration" class="w-full max-w-lg" />
        </div>
      </div>
    </div>
  </section>

  <!-- My Story Section -->
  <section class="bg-gray-50 py-24">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl md:text-5xl font-bold text-center mb-6 text-gray-900">
        My Story
      </h2>
      <p class="text-center text-gray-600 mb-20 max-w-2xl mx-auto text-lg leading-relaxed">
        I’ve faced this again and again. I begin in a product or a design role, but end up wearing many hats.
      </p>
      
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Card 1: Halostt -->
        <div class="text-center">
          <div class="rounded-lg mb-6 min-h-[280px] flex items-center justify-center">
            <img src={hatsCollection.src} alt="Story illustration 1" class="w-full max-w-xs" />
          </div>
          <div class="text-left">
            <p class="text-gray-700 mb-2">
              At <strong><u><a href="https://www.itelasoft.com.au/" target="parent">Itelasoft</a></u></strong>, I was hired as a UX Designer, but became a Frontend Developer and a Design Manager.
            </p>
          </div>
        </div>

        <!-- Card 2: Wittaya Aqua -->
        <div class="text-center">
          <div class="rounded-lg mb-6 min-h-[280px] flex items-center justify-center">
            <img src={moreHats.src} alt="Story illustration 2" class="w-full max-w-xs" />
          </div>
          <div class="text-left">
            <p class="text-gray-700 mb-2">
              At <strong><u><a href="https://wittaya-aqua.ca/en/" target="parent">Wittaya Aqua</a></u></strong>, I was Hired as a UX Designer, but ended up a Frontend Developer and a Content Creator.
            </p>
          </div>
        </div>

        <!-- Card 3: Scotiabank -->
        <div class="text-center">
          <div class="rounded-lg mb-6 min-h-[280px] flex items-center justify-center">
            <img src={evenMoreHats.src} alt="Story illustration 3" class="w-full max-w-xs" />
          </div>
          <div class="text-left">
            <p class="text-gray-700 mb-2">
              At <strong><u><a href="https://www.gbm.scotiabank.com/en.html" target="parent">Scotiabank</a></u></strong>, I was hired as a Product Designer, ended up as Technical BA and a Release Manager.
            </p>
          </div>
        </div>
      </div>

      <p class="text-center text-gray-600 mt-12 italic">
        If I join your company, what hats will I wear?<br />
        Whatever they are, I'll wear them in style.
      </p>
    </div>
  </section>

  <!-- My Work Section -->
  <section id="my-work" class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl md:text-5xl font-bold text-center mb-20 text-gray-900">
        My Work
      </h2>
      
      <div class="grid md:grid-cols-3 gap-8">
        <ProjectSummary
          title="Solar Offset App"
          description="A full end-to-end product case study showcasing my methodology, decision-making, and mobile B2C design and dark-mode expertise UI."
          imageSrc={mobileApp.src}
          imageAlt="Solar Offset App"
          href="solar-offset"
        />

        <ProjectSummary
          title="ETF Dashboard"
          description="A data-heavy B2B dashboard designed for clarity in complex workflows, highlighting my strengths in information design and dark-mode enterprise UI."
          imageSrc={dashboard.src}
          imageAlt="ETF Dashboard"
          href="etf-dashboard"
        />

        <ProjectSummary
          title="Scotiabank Projects"
          description="High-impact enterprise tools designed for large-scale financial operations: work I can discuss but not display."
          imageSrc={enterprise.src}
          imageAlt="Scotiabank Projects"
          href="scotiabank"
        />
      </div>
    </div>
  </section>

  <!-- What I Bring Section -->
  <section class="py-24 bg-gray-50">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-4xl md:text-5xl font-bold text-center mb-20 text-gray-900">
        What I bring, and what I expect
      </h2>
      
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <img src={character2.src} alt="Supul's character" class="w-full max-w-md mx-auto" />
        </div>
        <div class="space-y-6 text-gray-700 text-lg">
          <p>
            I bring a blend of UX, interaction, and design expertise, backed by enough technical know-how to keep everything realistic. I’m comfortable picking up new roles when the situation calls for it. 
          </p>
          <p class="font-medium">
            PS: I’m particularly good in chaotic environments, release management has trained me well!
          <p>
            I expect a culture that values growth and invests in its people. I thrive in nurturing environments where expanding skills, trying new things, and learning openly are part of the process.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact CTA Section -->
  <ContactCTA href="#contact" target="_self" />
</HomeLayout>
