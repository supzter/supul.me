---
interface Props {
  title: string;
  description: string;
  imageSrc: string;
  imageAlt: string;
  href: string;
}

const { title, description, imageSrc, imageAlt, href } = Astro.props;
---

<div class="flex flex-col items-center text-center">
  <div class="mb-6 flex items-center justify-center w-full">
    <img src={imageSrc} alt={imageAlt} class="w-full max-w-xs" />
  </div>
  <div>
    <h3 class="text-2xl font-bold mb-3 text-gray-900">{title}</h3>
    <p class="text-gray-600 mb-6">
      {description}
    </p>
    <a href={href} class="inline-block px-6 py-2 bg-[#50A684] text-white rounded-full hover:bg-[#3D8268] transition-colors font-medium">
      See More
    </a>
  </div>
</div>