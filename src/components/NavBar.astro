---
import '../styles/global.css';
import resume from '../../public/Supul-amarakoon-resume-2026.pdf';
---

<nav class="bg-white sticky top-0 z-50 shadow-sm">
  <div class="max-w-7xl mx-auto px-6 py-4">
    <div class="flex justify-between items-center">
      <div class="flex gap-8 items-center">
        <a href="./" class="text-xl font-bold text-gray-900">Home</a>
        <a href="./#my-work" class="text-gray-700 hover:text-[#50A684] transition-colors">Design Portfolio</a>
      </div>
      <div>
        <a href={resume} class="px-5 py-2 bg-[#50A684] text-white rounded-full hover:bg-[#3D8268] transition-colors font-medium resumebtn" target="parent">
          Resume
        </a>
      </div>
    </div>
  </div>
</nav>