---
interface Props {
  href?: string;
  target?: string;
}

const { href = "mailto:supul.amarakoon@gmail.com", target = "_parent" } = Astro.props;
---

<section class="py-20 bg-gradient-to-r from-[#4A9A7A] via-[#50A684] to-[#5BB28E] text-white">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-6">
      Curious to connect?
    </h2>
    <a
      href="mailto:supul.amarakoon@gmail.com"
      target="parent"
      class="connectbtn inline-block px-8 py-3 bg-white text-[#50A684] rounded-full hover:bg-gray-100 transition-colors font-medium text-lg"
    >
      Let's get in touch :)
    </a>
  </div>
</section>