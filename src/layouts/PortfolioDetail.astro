---
interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  heroImage?: string;
}

const { title, subtitle, description = "Portfolio Project - Supul Amarakoon", heroImage } = Astro.props;
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="bg-white text-gray-900 min-h-screen">
    <!-- Navigation -->
    <nav class="bg-white">
      <div class="max-w-7xl mx-auto px-6 py-4">
        <div class="flex justify-between items-center">
          <div class="flex gap-8 items-center">
            <a href="/" class="text-xl font-bold text-gray-900">Home</a>
            <a href="/design-portfolio" class="text-gray-700 hover:text-[#50A684] transition-colors">Design Portfolio</a>
          </div>
          <div>
            <a href="/resume.pdf" class="px-5 py-2 bg-[#50A684] text-white rounded-full hover:bg-[#3D8268] transition-colors font-medium">
              Resume
            </a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Hero Header -->
    <section class="bg-gradient-to-r from-[#4A9A7A] via-[#50A684] to-[#5BB28E] text-white py-16 md:py-20">
      <div class="max-w-7xl mx-auto px-6">
        {heroImage ? (
          <div class="flex items-center justify-between gap-12">
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold flex-1">
              {title}
            </h1>
            <div class="flex-shrink-0">
              <img src={heroImage} alt={title} class="w-64 md:w-80 lg:w-96 drop-shadow-2xl" />
            </div>
          </div>
        ) : (
          <h1 class="text-4xl md:text-6xl font-bold text-center">
            {title}
          </h1>
        )}
        {subtitle && !heroImage && (
          <p class="text-xl md:text-2xl text-center mt-4 text-white/90">
            {subtitle}
          </p>
        )}
      </div>
    </section>

    <!-- Main Content -->
    <slot />

    <!-- Footer -->
    <footer class="bg-gradient-to-r from-[#4A9A7A] via-[#50A684] to-[#5BB28E] text-white py-12">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex justify-center items-center gap-8 mb-4">
          <a href="https://behance.net" target="_blank" rel="noopener noreferrer" 
             class="text-2xl font-bold hover:text-gray-200 transition-colors"
             aria-label="Behance">
            Be
          </a>
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer"
             class="text-2xl font-bold hover:text-gray-200 transition-colors"
             aria-label="LinkedIn">
            in
          </a>
          <a href="https://medium.com" target="_blank" rel="noopener noreferrer"
             class="text-2xl font-bold hover:text-gray-200 transition-colors"
             aria-label="Medium">
            M
          </a>
        </div>
        <p class="text-center text-sm text-white/80">
          © {new Date().getFullYear()} Supul Amarakoon. All rights reserved.
        </p>
      </div>
    </footer>
  </body>
</html>
